@model IEnumerable<ProgrammingForTheCloud.Models.MenuItem>

@{
    ViewData["Title"] = "Restaurant Menu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Uploaded Menus</h2>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to Restaurants</a>
            <a asp-action="CreateMenu" asp-route-restaurantId="@ViewBag.RestaurantId" class="btn btn-primary">
                + Add New Menu
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            This restaurant doesn't have any menus yet. Click "+ Add New Menu" to upload one.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var menu in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        @if (!string.IsNullOrEmpty(menu.ImageUrl))
                        {
                            <img src="@Url.Action("GetMenuImage", "Restaurant", new { imageUrl = menu.ImageUrl })" class="card-img-top" alt="Menu image" style="height:240px;object-fit:cover;" />
                        }
                        <div class="card-body d-flex flex-column">
                            <a asp-controller="Restaurant"
                               asp-action="Details"
                               asp-route-restaurantId="@ViewBag.RestaurantId"
                               asp-route-menuId="@menu.Id"
                               class="btn btn-primary mt-auto">
                                View Scanned Items
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>