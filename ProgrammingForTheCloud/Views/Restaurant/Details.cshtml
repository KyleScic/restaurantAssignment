@model List<ParsedMenuItem>

<h2>Menu Details</h2>

@if (Model != null && Model.Count > 0)
{
    <table class="table">
        <thead>
        <tr>
            <th>Category</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Category</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>$@item.Price.ToString("0.00")</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        <strong>Processing:</strong> Please wait a few seconds and refresh the page!
    </div>
}